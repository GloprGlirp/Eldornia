; Eldornia – Godot 4 Spielclient
; Engine configuration file.

config_version=5

[application]

config/name="Eldornia"
config/description="Fantasy-MMORPG im Stil von World of Warcraft und RuneScape"
config/version="0.2.0"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.055, 0.043, 0.035, 1)
boot_splash/show_image=false
config/windows_native_icon="res://assets/icon.ico"

[autoload]

Settings="*res://src/autoload/settings.gd"
Content="*res://src/autoload/content.gd"
Net="*res://src/autoload/net.gd"
Game="*res://src/autoload/game.gd"
Sfx="*res://src/autoload/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

theme/default_font_antialiasing=1
timers/tooltip_delay_sec=0.25

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
environment/defaults/default_clear_color=Color(0.055, 0.043, 0.035, 1)
textures/default_filters/anisotropic_filtering_level=3
shading/overrides/force_lambert_over_burley=false
textures/vram_compression/import_etc2_astc=true
